{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bhyo-markt",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Neon (Production-Branch) ueber Hyperdrive. Die ID ist kein Zugriffsgeheimnis;
  // der echte Connection-String liegt in der Hyperdrive-Config, nie im Repo.
  // localConnectionString ist ein reines localhost-Ziel (kein Secret): lokal
  // materialisiert es die Bindung fuer getCloudflareContext, und OpenNext verlangt
  // es ueber getPlatformProxy auch beim Deploy. Zur Laufzeit im Worker nutzt
  // Cloudflare die echte Hyperdrive-Config, nicht diesen Wert.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "2a873aa18f654dc4897b145cb24db7d7",
      "localConnectionString": "postgres://user:pass@localhost:5432/bhyo"
    }
  ],
  // Beleg-Dateien. EU-Jurisdiction wie beim Backup-Bucket (AP0c). Ausgabe laeuft
  // ueber eine Worker-Route hinter Access, die per Bindung streamt – keine
  // langlebigen S3-Credentials im Repo. Preview teilt sich denselben Bucket;
  // die Belege-Route praefixt Keys mit der Umgebung, damit sich Test-Uploads
  // aus Preview nicht mit Production-Belegen vermischen.
  "r2_buckets": [
    {
      "binding": "BELEGE",
      "bucket_name": "bhyogenics-belege",
      "jurisdiction": "eu"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "ACCESS_TEAM_DOMAIN": "bhyo.cloudflareaccess.com",
    // AUD-Tag der Access-App "bhyo-markt" (Production). Kein Secret, aber pro App
    // verschieden.
    "ACCESS_AUD": "e41cb1bf78c4a982bd0aff5a40997c3c7b5a3a8f77f06b6c9df121b6cb9b03cd"
  },
  // Zweite Umgebung für Preview-Deployments (Pull Requests).
  "env": {
    "preview": {
      "name": "bhyo-markt-preview",
      // Neon (Preview-Branch) ueber die separate Hyperdrive-Config.
      // localConnectionString wie oben nur lokal genutzt; wird auch beim Deploy
      // von OpenNext (getPlatformProxy) verlangt, daher an beiden Bindings noetig.
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "7bf0712cc8224c32a061ef0abea561f9",
          "localConnectionString": "postgres://user:pass@localhost:5432/bhyo"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BELEGE",
          "bucket_name": "bhyogenics-belege",
          "jurisdiction": "eu"
        }
      ],
      "vars": {
        "ENVIRONMENT": "preview",
        "ACCESS_TEAM_DOMAIN": "bhyo.cloudflareaccess.com",
        // AUD-Tag der Access-App "bhyo-markt-preview".
        "ACCESS_AUD": "133168fc7c07ed99b522187b5ff097291835f427d21b2e9af0ca8cbf4936befd"
      }
    }
  }
}
